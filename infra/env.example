# Local development placeholders. Replace via shell or a private --env-file.
MYSQL_ROOT_PASSWORD=local-only-root-password
MYSQL_PASSWORD=local-only-app-password
MINIO_ROOT_USER=orbit-local
MINIO_ROOT_PASSWORD=local-only-minio-password

# docker compose -f infra/docker-compose.yml up -d --build
# Origin: https://localhost:8443  |  Mailpit inbox: http://localhost:8025
# For a host Spring Boot + Vite pair, expose ports 8080 / 5173 to the bridge.
# The proxy generates a localhost certificate in its private volume on startup.
# Export the public certificate for local trust or curl --cacert:
# docker compose -f infra/docker-compose.yml cp nginx:/etc/nginx/local-tls/localhost.crt /tmp/orbitspace-localhost.crt
# Once the application Dockerfiles exist, --profile fullstack also starts server:8080 and web:80.
