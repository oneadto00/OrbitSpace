<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.orbitspace</groupId>
    <artifactId>orbit-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>orbit-kernel</module>
        <module>orbit-platform</module>
        <module>orbit-security</module>
        <module>orbit-mod-identity</module>
        <module>orbit-mod-space</module>
        <module>orbit-mod-chat</module>
        <module>orbit-mod-gitproject</module>
        <module>orbit-mod-friendship</module>
        <module>orbit-mod-file</module>
        <module>orbit-mod-integration</module>
        <module>orbit-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <aws-sdk.version>2.59.3</aws-sdk.version>
        <jjwt.version>0.13.0</jjwt.version>
    </properties>

    <!-- The Boot parent manages Spring starters, Flyway and Connector/J. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-space</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-gitproject</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-friendship</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.orbitspace</groupId>
                <artifactId>orbit-mod-integration</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
