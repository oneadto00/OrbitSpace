{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collaboration hook request",
  "description": "Select the request and response definitions by HTTP path. Base64 fields contain Yjs V1 document updates. Awareness is ephemeral. Store batches contain edits from one authenticated session only.",
  "anyOf": [
    {
      "$ref": "#/$defs/CollabAuthenticate"
    },
    {
      "$ref": "#/$defs/CollabLoad"
    },
    {
      "$ref": "#/$defs/CollabStoreBatch"
    },
    {
      "$ref": "#/$defs/CollabRevokeCheck"
    }
  ],
  "$defs": {
    "CollabAuthenticate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "ticket"
      ],
      "properties": {
        "documentId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "CollabSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "sessionId",
        "spaceId",
        "userId",
        "membershipEpoch",
        "role",
        "readOnly"
      ],
      "properties": {
        "documentId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "sessionId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "spaceId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "userId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "membershipEpoch": {
          "$ref": "../common.schema.json#/$defs/PositiveSequence"
        },
        "role": {
          "$ref": "../common.schema.json#/$defs/SpaceRole"
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "CollabLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "sessionId"
      ],
      "properties": {
        "documentId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "sessionId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "cursor": {
          "$ref": "../common.schema.json#/$defs/Id"
        }
      }
    },
    "CollabUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchSeq",
        "update"
      ],
      "properties": {
        "batchSeq": {
          "$ref": "../common.schema.json#/$defs/PositiveSequence"
        },
        "update": {
          "type": "string",
          "contentEncoding": "base64",
          "format": "byte",
          "minLength": 4,
          "maxLength": 8388608,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "CollabStatePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batches",
        "persistedBatchSeq",
        "nextCursor"
      ],
      "properties": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "throughBatchSeq",
            "update"
          ],
          "properties": {
            "throughBatchSeq": {
              "$ref": "../common.schema.json#/$defs/Sequence"
            },
            "update": {
              "type": "string",
              "contentEncoding": "base64",
              "format": "byte",
              "minLength": 4,
              "maxLength": 67108864,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollabUpdate"
          },
          "minItems": 0
        },
        "persistedBatchSeq": {
          "$ref": "../common.schema.json#/$defs/Sequence"
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CollabStoreBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "sessionId",
        "batchId",
        "expectedPersistedBatchSeq",
        "update"
      ],
      "properties": {
        "documentId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "sessionId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "batchId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "expectedPersistedBatchSeq": {
          "$ref": "../common.schema.json#/$defs/Sequence"
        },
        "update": {
          "type": "string",
          "contentEncoding": "base64",
          "format": "byte",
          "minLength": 4,
          "maxLength": 8388608,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "CollabBatchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "batchId",
        "persistedBatchSeq"
      ],
      "properties": {
        "documentId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "batchId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "persistedBatchSeq": {
          "$ref": "../common.schema.json#/$defs/PositiveSequence"
        }
      }
    },
    "CollabRevokeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "sessionId"
      ],
      "properties": {
        "documentId": {
          "$ref": "../common.schema.json#/$defs/Id"
        },
        "sessionId": {
          "$ref": "../common.schema.json#/$defs/Id"
        }
      }
    },
    "CollabAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "membershipEpoch"
      ],
      "properties": {
        "readOnly": {
          "type": "boolean"
        },
        "membershipEpoch": {
          "$ref": "../common.schema.json#/$defs/PositiveSequence"
        }
      }
    }
  }
}
